{
  "name": "fpv-phone-controller",
  "private": true,
  "scripts": {
    "phone": "npm --prefix phone run start",
    "desktop": "npm --prefix desktop run dev",
    "build": "npm --prefix shared run build && npm --prefix desktop run build && npm --prefix phone run build",
    "test": "npm run test:phone && npm --prefix desktop test",
    "test:phone": "npm --prefix phone test",
    "build:desktop": "npm --prefix phone run build && npm --prefix desktop run build && node scripts/build-desktop.mjs",
    "package:windows": "npm run build:desktop && node scripts/package-windows.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.33",
    "koffi": "^3.3.2",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/pwa": "^20.3.33",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "0.28.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "version": "0.2.0",
  "overrides": {
    "@modelcontextprotocol/sdk": "1.31.0"
  }
}
